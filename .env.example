# Токен бота, выданный @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID можно у @userinfobot)
ADMIN_TELEGRAM_IDS=123456789

# Публичный HTTPS-адрес, на котором живёт сервер — используется и для мини-аппа, и для Telegram-вебхука.
# На Render это https://<имя-сервиса>.onrender.com, при своём VPS+домене — https://ваш-домен
PUBLIC_URL=https://example.onrender.com

# Домен для Caddy (нужен только при деплое на свой VPS через docker-compose, без https://)
DOMAIN=example.com

# Часовой пояс компании (IANA), используется для расчёта опозданий
TIMEZONE=Europe/Moscow

# Порт, на котором слушает сервер (Render подставит свой автоматически)
PORT=3000

# Строка подключения к Postgres (бесплатно — Supabase или Neon), формат:
# postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
